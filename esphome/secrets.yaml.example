# Copy to secrets.yaml (same folder) and fill in. Keep secrets.yaml private.
wifi_ssid: "YourWiFi"
wifi_password: "your-wifi-password"
fallback_ap_password: "pick-8-or-more-chars"
ota_password: "pick-a-password"

# The FPP running the Yard Security plugin (Yard-Security). Its IP is safest.
mqtt_broker: "192.168.1.50"
# Same user and password as "Sensor connection (MQTT)" on the plugin page.
mqtt_username: "yardsecurity"
mqtt_password: "paste-the-password-from-the-plugin-page"
